rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function profile() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function activeUser() {
      return profileExists() && profile().activo == true;
    }

    function recentAuthentication() {
      return signedIn() && request.auth.token.auth_time is int &&
        request.auth.token.auth_time >= (request.time.toMillis() / 1000) - 900;
    }

    function companyOperational(empresaId) {
      let empresa = get(
        /databases/$(database)/documents/empresas/$(empresaId)
      ).data;
      return empresa.activa != false;
    }

    function canWriteCompany(data) {
      return companyOperational(data.empresaId);
    }

    function hasRole(roles) {
      return activeUser() && profile().rol in roles;
    }

    function isSuperAdmin() {
      return hasRole(['super_admin']);
    }

    function isCompanyAdmin() {
      return hasRole([
        'admin_empresa',
        'admin_sucursal'
      ]);
    }

    function isWorkshopUser() {
      return hasRole([
        'jefe_taller',
        'supervisor',
        'tecnico'
      ]);
    }

    function sameCompany(data) {
      return activeUser() &&
        data.empresaId is string &&
        profile().empresaId == data.empresaId;
    }

    function isCompanyWideAdmin() {
      return hasRole(['admin_empresa']);
    }

    function isBranchRole() {
      return hasRole([
        'admin_sucursal',
        'jefe_taller',
        'supervisor',
        'tecnico',
        'planificador',
        'bodeguero',
        'sheq'
      ]);
    }

    function sameBranch(data) {
      return sameCompany(data) &&
        profile().sucursalId is string &&
        profile().sucursalId != '' &&
        data.sucursalId is string &&
        profile().sucursalId == data.sucursalId;
    }

    // Valida una sola vez el ámbito inmutable de una actualización de OT.
    // Evita repetir sameCompany/sameBranch y mantiene la evaluación bajo el
    // límite de expresiones de Firestore sin ampliar los permisos existentes.
    function validWorkshopOtUpdateScope() {
      let user = profile();
      return profileExists() &&
        user.activo == true &&
        user.rol in ['jefe_taller', 'supervisor', 'tecnico'] &&
        resource.data.empresaId is string &&
        resource.data.sucursalId is string &&
        user.empresaId == resource.data.empresaId &&
        user.sucursalId == resource.data.sucursalId &&
        companyOperational(resource.data.empresaId) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.sucursalId == resource.data.sucursalId &&
        request.resource.data.creadoPor == resource.data.creadoPor;
    }

    function canReadBranchData(data) {
      return (isCompanyWideAdmin() && sameCompany(data)) ||
        (isBranchRole() && sameBranch(data));
    }

    function canReadSheq(data) {
      return (
        sameCompany(data) &&
        hasRole(['admin_empresa', 'admin_sucursal', 'jefe_taller', 'planificador', 'sheq']) &&
        moduloEtapaActivo(empresaDeOT(data), 'sheq')
      );
    }

    function canManageSheq(data) {
      return (
        sameCompany(data) &&
        hasRole(['sheq']) &&
        canWriteCompany(data) &&
        moduloEtapaActivo(empresaDeOT(data), 'sheq')
      );
    }

    function canManageProgramming(data) {
      return (
        hasRole(['planificador']) && sameCompany(data) &&
        moduloEtapaActivo(empresaDeOT(data), 'programacion')
      );
    }

    function canReadProgrammingDraft(data) {
      return (
        sameCompany(data) && hasRole(['planificador', 'bodeguero']) &&
        moduloEtapaActivo(empresaDeOT(data), 'programacion')
      );
    }

    function canReadPublishedProgramming(data) {
      return sameCompany(data) &&
        data.estado == 'publicada' &&
        hasRole(['admin_empresa', 'admin_sucursal', 'jefe_taller', 'sheq']) &&
        moduloEtapaActivo(empresaDeOT(data), 'programacion');
    }

    function empresaDeOT(data) {
      return get(
        /databases/$(database)/documents/empresas/$(data.empresaId)
      ).data;
    }

    function moduloEtapaActivo(empresa, modulo) {
      return !('modulos' in empresa) ||
        !(empresa.modulos is map) ||
        !(modulo in empresa.modulos) ||
        empresa.modulos[modulo] != false;
    }

    function indicadorActivo(data, campo) {
      return campo in data && data[campo] == true;
    }

    function ingresoCompleto(data, empresa) {
      return !moduloEtapaActivo(empresa, 'ingreso') ||
        indicadorActivo(data, 'ingresoAprobado');
    }

    function evaluacionCompleta(data, empresa) {
      return !moduloEtapaActivo(empresa, 'evaluacion') ||
        indicadorActivo(data, 'evaluacionAprobada');
    }

    function mantencionRequerida(data, empresa) {
      return !moduloEtapaActivo(empresa, 'evaluacion') ||
        !('overhaulRequerido' in data) ||
        data.overhaulRequerido != false;
    }

    function mantencionCompleta(data, empresa) {
      return !moduloEtapaActivo(empresa, 'mantencion') ||
        !mantencionRequerida(data, empresa) ||
        indicadorActivo(data, 'overhaulAprobado');
    }

    function pruebasCompletas(data, empresa) {
      return !moduloEtapaActivo(empresa, 'pruebas') ||
        !mantencionRequerida(data, empresa) ||
        indicadorActivo(data, 'pruebasAprobado');
    }

    function estadoOTValido(data) {
      return data.estado in [
        'INGRESO',
        'EVALUACION',
        'OVERHAUL',
        'PRUEBAS',
        'DESPACHO',
        'CERRADA'
      ];
    }

    function avanceOTValido(data, empresa) {
      return
        // Los estados finales se evalúan primero para no agotar el límite
        // de expresiones de Firestore durante el cierre de una OT.
        (data.estado == 'CERRADA' &&
          data.cerrada == true &&
          ingresoCompleto(data, empresa) &&
          evaluacionCompleta(data, empresa) &&
          mantencionCompleta(data, empresa) &&
          pruebasCompletas(data, empresa)) ||
        (data.estado == 'INGRESO' && moduloEtapaActivo(empresa, 'ingreso')) ||
        (data.estado == 'EVALUACION' &&
          ingresoCompleto(data, empresa) &&
          moduloEtapaActivo(empresa, 'evaluacion')) ||
        (data.estado == 'OVERHAUL' &&
          ingresoCompleto(data, empresa) &&
          evaluacionCompleta(data, empresa) &&
          mantencionRequerida(data, empresa) &&
          moduloEtapaActivo(empresa, 'mantencion')) ||
        (data.estado == 'PRUEBAS' &&
          ingresoCompleto(data, empresa) &&
          evaluacionCompleta(data, empresa) &&
          mantencionCompleta(data, empresa) &&
          moduloEtapaActivo(empresa, 'pruebas')) ||
        (data.estado == 'DESPACHO' &&
          ingresoCompleto(data, empresa) &&
          evaluacionCompleta(data, empresa) &&
          mantencionCompleta(data, empresa) &&
          pruebasCompletas(data, empresa) &&
          moduloEtapaActivo(empresa, 'despacho'));
    }

    function puedeAprobarOCerrarOT() {
      return hasRole(['jefe_taller']);
    }

    function aprobacionSeleccionada(data, etapa) {
      return ('aprobacionesPorEtapa' in data && data.aprobacionesPorEtapa is map)
        ? (etapa in data.aprobacionesPorEtapa && data.aprobacionesPorEtapa[etapa] == true)
        : etapa in ['evaluacion', 'pruebas'];
    }

    function etapaIniciada(data, etapa) {
      return ('etapasConActividad' in data && data.etapasConActividad is map) &&
        (etapa in data.etapasConActividad) &&
        data.etapasConActividad[etapa] == true;
    }

    function marcasActividadValidas() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      return !('etapasConActividad' in request.resource.data)
        ? !cambios.hasAny(['evaluacion', 'overhaul', 'repuestos', 'pruebas', 'despacho'])
        : marcasActividadPresentesValidas(cambios);
    }

    function marcasActividadPresentesValidas(cambios) {
      let nuevas = request.resource.data.etapasConActividad;
      return nuevas is map &&
        nuevas.evaluacion is bool &&
        nuevas.mantencion is bool &&
        nuevas.pruebas is bool &&
        nuevas.despacho is bool &&
        (!etapaIniciada(resource.data, 'evaluacion') || nuevas.evaluacion == true) &&
        (!etapaIniciada(resource.data, 'mantencion') || nuevas.mantencion == true) &&
        (!etapaIniciada(resource.data, 'pruebas') || nuevas.pruebas == true) &&
        (!etapaIniciada(resource.data, 'despacho') || nuevas.despacho == true) &&
        (!cambios.hasAny(['evaluacion']) || nuevas.evaluacion == true) &&
        (!cambios.hasAny(['overhaul', 'repuestos']) || nuevas.mantencion == true) &&
        (!cambios.hasAny(['pruebas']) || nuevas.pruebas == true) &&
        (!cambios.hasAny(['despacho']) || nuevas.despacho == true);
    }

    function cambiaConfiguracionAprobaciones() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['aprobacionesPorEtapa']);
    }

    function configuracionAprobacionesValida() {
      let anterior = resource.data.aprobacionesPorEtapa;
      let nueva = request.resource.data.aprobacionesPorEtapa;
      return puedeAprobarOCerrarOT() &&
        anterior is map && nueva is map &&
        nueva.evaluacion is bool && nueva.mantencion is bool &&
        nueva.pruebas is bool && nueva.despacho is bool &&
        (anterior.evaluacion == nueva.evaluacion || !etapaIniciada(resource.data, 'evaluacion')) &&
        (anterior.mantencion == nueva.mantencion || !etapaIniciada(resource.data, 'mantencion')) &&
        (anterior.pruebas == nueva.pruebas || !etapaIniciada(resource.data, 'pruebas')) &&
        (anterior.despacho == nueva.despacho || !etapaIniciada(resource.data, 'despacho'));
    }

    function cambiaDatosExclusivosJefe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'equipo', 'serie', 'cliente', 'os', 'osGenerica',
        'gamaEquipo', 'plantillaMantenimientoId', 'plantillaMantenimientoNombre',
        'plantillaMantenimientoVersion', 'etapasHabilitadas', 'gantt'
      ]);
    }

    function cambiaCamposAprobacionOT() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      return
        (aprobacionSeleccionada(resource.data, 'evaluacion') &&
          cambios.hasAny(['decisionEvaluacion', 'evaluacionAprobada', 'overhaulRequerido'])) ||
        (aprobacionSeleccionada(resource.data, 'mantencion') &&
          cambios.hasAny(['decisionMantencion', 'overhaulAprobado'])) ||
        (aprobacionSeleccionada(resource.data, 'pruebas') &&
          cambios.hasAny(['decisionPruebas', 'pruebasAprobado'])) ||
        (aprobacionSeleccionada(resource.data, 'despacho') &&
          cambios.hasAny(['decisionDespacho', 'despachoAprobado']));
    }

    function cambiaCamposCierreOT() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'cerrada',
        'fechaCierre',
        'cerradoPor',
        'cerradoPorNombre',
        'cerradoPorRol'
      ]);
    }

    function actualizacionRecepcionBodegueroValida() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      let cambiaRecepcion = cambios.hasAny([
        'recibido', 'fechaRecepcion', 'recibidoPor', 'recibidoPorNombre'
      ]);
      return hasRole(['bodeguero']) &&
        cambios.hasOnly([
          'recibido', 'fechaRecepcion', 'recibidoPor', 'recibidoPorNombre',
          'estado', 'fechaActualizacion', 'actualizadoPor'
        ]) &&
        request.resource.data.actualizadoPor == request.auth.uid &&
        request.resource.data.estado in ['Parcial', 'Completa'] &&
        (
          !cambiaRecepcion ||
          (
            request.resource.data.recibido is bool &&
            request.resource.data.recibido == true &&
            request.resource.data.recibidoPor == request.auth.uid &&
            request.resource.data.recibidoPorNombre is string &&
            request.resource.data.recibidoPorNombre.size() > 0 &&
            request.resource.data.fechaRecepcion is timestamp
          ) ||
          (
            request.resource.data.recibido is bool &&
            request.resource.data.recibido == false &&
            !('recibidoPor' in request.resource.data) &&
            !('recibidoPorNombre' in request.resource.data) &&
            !('fechaRecepcion' in request.resource.data)
          )
        );
    }

    // Ámbito común para editar un repuesto existente. Mantiene empresa,
    // sucursal y autor originales, y evita repetir las mismas lecturas de
    // perfil en cada alternativa de la regla.
    function validInventoryItemUpdateScope() {
      let user = profile();
      return profileExists() &&
        user.activo == true &&
        user.rol in ['jefe_taller', 'planificador', 'bodeguero'] &&
        resource.data.empresaId is string &&
        resource.data.sucursalId is string &&
        user.empresaId == resource.data.empresaId &&
        user.sucursalId == resource.data.sucursalId &&
        companyOperational(resource.data.empresaId) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.sucursalId == resource.data.sucursalId &&
        request.resource.data.creadoPor == resource.data.creadoPor &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'inventario');
    }

    function actualizacionOTValida() {
      let empresa = empresaDeOT(request.resource.data);
      return (
          !(
            cambiaCamposAprobacionOT() ||
            cambiaCamposCierreOT() ||
            cambiaDatosExclusivosJefe()
          ) ||
          puedeAprobarOCerrarOT()
        ) && (
          !cambiaConfiguracionAprobaciones() ||
          configuracionAprobacionesValida()
        ) && marcasActividadValidas() && (
          puedeAprobarOCerrarOT() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ingreso', 'evaluacion', 'overhaul', 'pruebas', 'despacho',
            'repuestos', 'estado', 'ingresoAprobado', 'evaluacionAprobada',
            'overhaulRequerido', 'overhaulAprobado', 'pruebasAprobado',
            'despachoAprobado', 'decisionEvaluacion', 'decisionMantencion',
            'decisionPruebas', 'decisionDespacho', 'bitacora',
            'etapasConActividad', 'revision', 'fechaActualizacion'
          ])
        ) && (
          request.resource.data.estado == resource.data.estado || (
            estadoOTValido(request.resource.data) &&
            avanceOTValido(request.resource.data, empresa)
          )
        );
    }

    function solicitaCierreOT() {
      return resource.data.cerrada != true &&
        request.resource.data.cerrada == true &&
        request.resource.data.estado == 'CERRADA';
    }

    function cierreOTValido() {
      let empresa = empresaDeOT(request.resource.data);
      return puedeAprobarOCerrarOT() &&
        ingresoCompleto(request.resource.data, empresa) &&
        evaluacionCompleta(request.resource.data, empresa) &&
        mantencionCompleta(request.resource.data, empresa) &&
        pruebasCompletas(request.resource.data, empresa) &&
        (!aprobacionSeleccionada(request.resource.data, 'despacho') ||
          indicadorActivo(request.resource.data, 'despachoAprobado'));
    }

    // Los perfiles se crean y administran mediante Cloud Functions.
    // El cliente solo puede leerlos y confirmar el cambio de contraseña.
    match /usuarios/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (isCompanyWideAdmin() && sameCompany(resource.data)) ||
        (hasRole(['admin_sucursal', 'jefe_taller', 'planificador', 'bodeguero', 'sheq']) && sameBranch(resource.data))
      );

      allow list: if isSuperAdmin() || (
        isCompanyWideAdmin() && sameCompany(resource.data)
      ) || (
        hasRole(['admin_sucursal', 'bodeguero', 'sheq']) && sameBranch(resource.data)
      ) || (
        hasRole(['jefe_taller', 'planificador']) && sameBranch(resource.data)
      );

      allow create, delete: if false;

      allow update: if (
        signedIn() &&
        request.auth.uid == userId &&
        companyOperational(profile().empresaId) &&
        resource.data.activo == true &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['debeCambiarPassword', 'fechaActualizacion']) &&
        resource.data.debeCambiarPassword == true &&
        request.resource.data.debeCambiarPassword == false
      ) || (
        (
          isSuperAdmin() ||
          (
            hasRole(['sheq']) &&
            sameBranch(resource.data) &&
            sameBranch(request.resource.data) &&
            canWriteCompany(resource.data)
          )
        ) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.sucursalId == resource.data.sucursalId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rut', 'fechaActualizacion'])
      );

    }

    match /empresas/{empresaId} {
      allow read: if isSuperAdmin() || (
        activeUser() && profile().empresaId == empresaId
      );

      allow create, delete: if isSuperAdmin();

      allow update: if isSuperAdmin() || (
        hasRole(['admin_empresa']) &&
        profile().empresaId == empresaId &&
        companyOperational(empresaId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'correo',
          'telefono',
          'ciudad',
          'pais',
          'direccion',
          'colorPrimario',
          'colorSecundario',
          'brandingInforme',
          'fechaActualizacion'
        ])
      );

      match /pagos/{pagoId} {
        allow read, create, update: if isSuperAdmin();
        allow delete: if false;
      }
    }

    match /sucursales/{sucursalId} {
      allow read: if isSuperAdmin() ||
        (isCompanyWideAdmin() && sameCompany(resource.data)) ||
        (isBranchRole() && sameCompany(resource.data) && profile().sucursalId == sucursalId);

      // Se crea exclusivamente mediante la Cloud Function, que valida el
      // límite contratado, el código único, el rol y la empresa activa.
      allow create: if false;

      // Los cambios de estado se realizan mediante una Cloud Function para
      // impedir desactivar sucursales con OT abiertas. El SDK Admin omite reglas.
      allow update: if isSuperAdmin();

      allow delete: if isSuperAdmin() || (
        hasRole(['admin_empresa']) && sameCompany(resource.data) &&
        companyOperational(resource.data.empresaId)
      );
    }

    match /ots/{otId} {
      allow read: if canReadBranchData(resource.data);

      allow create: if activeUser() && (
          sameCompany(request.resource.data) &&
          canWriteCompany(request.resource.data) &&
          sameBranch(request.resource.data) &&
          hasRole(['jefe_taller']) &&
          request.resource.data.creadoPor == request.auth.uid &&
          request.resource.data.cerrada == false &&
          (
            (request.resource.data.estado in ['INGRESO', 'Ingreso'] &&
              moduloEtapaActivo(
                empresaDeOT(request.resource.data),
                'ingreso'
              )) ||
            (request.resource.data.estado != 'INGRESO' &&
              request.resource.data.estado != 'Ingreso' &&
              estadoOTValido(request.resource.data) &&
              avanceOTValido(
                request.resource.data,
                empresaDeOT(request.resource.data)
              ))
          )
      );

      allow update: if (
        validWorkshopOtUpdateScope() &&
        resource.data.cerrada != true &&
        resource.data.estado != 'CERRADA' &&
          request.resource.data.cerrada == true ==
            (request.resource.data.estado == 'CERRADA') &&
          (
            (solicitaCierreOT() && recentAuthentication() && cierreOTValido()) ||
            (!solicitaCierreOT() && actualizacionOTValida())
          )
        );

      allow delete: if (
        hasRole(['jefe_taller']) && sameCompany(resource.data) &&
        sameBranch(resource.data) && canWriteCompany(resource.data) &&
        recentAuthentication()
      );
    }

    // Documento liviano para Dashboard e historial. Contiene únicamente
    // identificación, estado, avance y alertas; nunca evidencias ni archivos.
    match /otsResumen/{otId} {
      allow read: if canReadBranchData(resource.data);

      allow create: if (
        activeUser() &&
        sameCompany(request.resource.data) &&
        canWriteCompany(request.resource.data) &&
        (
          isCompanyWideAdmin() ||
          (isBranchRole() && sameBranch(request.resource.data))
        )
      );

      allow update: if (
        activeUser() &&
        canWriteCompany(resource.data) &&
        sameCompany(resource.data) &&
        sameCompany(request.resource.data) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.sucursalId == resource.data.sucursalId &&
        (
          isCompanyWideAdmin() ||
          (isBranchRole() && sameBranch(resource.data) && sameBranch(request.resource.data))
        )
      );

      allow delete: if (
        activeUser() && sameCompany(resource.data) && canWriteCompany(resource.data) &&
        (
          isCompanyWideAdmin() ||
          (isBranchRole() && sameBranch(resource.data))
        )
      );
    }

    // Colecciones futuras del modelo multiempresa.
    match /clientes/{documentId} {
      allow read: if sameCompany(resource.data);
      allow create: if isCompanyAdmin() && sameCompany(request.resource.data) && canWriteCompany(request.resource.data);
      allow update: if (
        isCompanyAdmin() &&
        canWriteCompany(resource.data) &&
        sameCompany(resource.data) &&
        sameCompany(request.resource.data)
      );
      allow delete: if hasRole(['admin_empresa']) && sameCompany(resource.data) && canWriteCompany(resource.data);
    }

    match /equipos/{documentId} {
      allow read: if sameCompany(resource.data);
      allow create: if isCompanyAdmin() && sameCompany(request.resource.data) && canWriteCompany(request.resource.data);
      allow update: if (
        isCompanyAdmin() &&
        canWriteCompany(resource.data) &&
        sameCompany(resource.data) &&
        sameCompany(request.resource.data)
      );
      allow delete: if hasRole(['admin_empresa']) && sameCompany(resource.data) && canWriteCompany(resource.data);
    }

    match /plantillasMantenimiento/{plantillaId} {
      allow read: if sameCompany(resource.data);
      allow create: if (
        hasRole(['admin_empresa']) && sameCompany(request.resource.data) &&
        canWriteCompany(request.resource.data) &&
        request.resource.data.creadoPor == request.auth.uid
      );
      allow update: if (
        hasRole(['admin_empresa']) && sameCompany(resource.data) &&
        canWriteCompany(resource.data) &&
        sameCompany(request.resource.data) &&
        request.resource.data.empresaId == resource.data.empresaId
      );
      allow delete: if (
        hasRole(['admin_empresa']) && sameCompany(resource.data) &&
        canWriteCompany(resource.data)
      );
    }

    // Inventario independiente por empresa y sucursal. Los técnicos pueden
    // consultar; administradores y jefes de taller pueden mantener existencias.
    match /inventarioConfiguraciones/{configId} {
      allow read: if canReadBranchData(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'inventario');

      allow create: if (
        activeUser() &&
        canWriteCompany(request.resource.data) &&
        canReadBranchData(request.resource.data) &&
        hasRole(['jefe_taller', 'planificador']) &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'inventario')
      );

      allow update: if (
        activeUser() &&
        canWriteCompany(resource.data) &&
        canReadBranchData(resource.data) &&
        canReadBranchData(request.resource.data) &&
        hasRole(['jefe_taller', 'planificador']) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.sucursalId == resource.data.sucursalId &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'inventario')
      );

      allow delete: if (
        hasRole(['jefe_taller']) &&
        canWriteCompany(resource.data) &&
        canReadBranchData(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'inventario')
      );
    }

    match /inventarioItems/{itemId} {
      allow read: if canReadBranchData(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'inventario');

      allow create: if (
        activeUser() &&
        canWriteCompany(request.resource.data) &&
        canReadBranchData(request.resource.data) &&
        hasRole(['jefe_taller', 'planificador']) &&
        request.resource.data.datos is map &&
        request.resource.data.creadoPor == request.auth.uid &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'inventario')
      );

      allow update: if (
        validInventoryItemUpdateScope() && (
          (
            profile().rol in ['jefe_taller', 'planificador'] &&
            request.resource.data.datos is map
          ) || (
            profile().rol == 'bodeguero' &&
            request.resource.data.datos == resource.data.datos &&
            actualizacionRecepcionBodegueroValida()
          )
        )
      );

      allow delete: if (
        activeUser() &&
        canWriteCompany(resource.data) &&
        canReadBranchData(resource.data) &&
        hasRole(['jefe_taller', 'planificador']) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'inventario')
      );
    }

    // Planificación semanal por empresa. Los trabajadores consultan su
    // programación y las jefaturas publican o actualizan asignaciones.
    match /programaciones/{programacionId} {
      // La planificación de trabajo todavía editable solo es visible para
      // Planificación y Bodega. Los demás roles consumen copias publicadas.
      allow read: if canReadProgrammingDraft(resource.data);

      allow create: if (
        hasRole(['planificador']) &&
        sameCompany(request.resource.data) &&
        canWriteCompany(request.resource.data) &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'programacion')
      );

      allow update: if (
        hasRole(['planificador']) &&
        sameCompany(resource.data) &&
        sameCompany(request.resource.data) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        canWriteCompany(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion')
      ) || (
        canManageSheq(resource.data) &&
        sameCompany(request.resource.data) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vehiculoId',
          'vehiculoNombre',
          'actualizadoPor',
          'fechaActualizacion'
        ]) &&
        !('vehiculoId' in request.resource.data) &&
        !('vehiculoNombre' in request.resource.data)
      );

      allow delete: if (
        hasRole(['planificador']) &&
        sameCompany(resource.data) &&
        canWriteCompany(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion')
      );
    }

    match /programacionSemanas/{semanaId} {
      allow read: if canReadProgrammingDraft(resource.data) ||
        canReadPublishedProgramming(resource.data);

      allow create: if (
        hasRole(['planificador']) &&
        sameCompany(request.resource.data) &&
        canWriteCompany(request.resource.data) &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'programacion')
      );

      allow update: if (
        hasRole(['planificador']) &&
        sameCompany(resource.data) &&
        sameCompany(request.resource.data) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        canWriteCompany(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion')
      );

      allow delete: if (
        hasRole(['planificador']) && sameCompany(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion')
      );
    }

    match /programacionHistorial/{historialId} {
      allow read: if canManageProgramming(resource.data);
      allow create: if (
        hasRole(['planificador']) &&
        sameCompany(request.resource.data) &&
        canWriteCompany(request.resource.data) &&
        request.resource.data.realizadoPor == request.auth.uid &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'programacion')
      );
      allow update, delete: if false;
    }

    match /programacionAusencias/{ausenciaId} {
      allow read: if canManageProgramming(resource.data) || (
        activeUser() && sameCompany(resource.data) &&
        resource.data.usuarioId == request.auth.uid &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion')
      );
      allow create: if (
        hasRole(['planificador']) &&
        sameCompany(request.resource.data) &&
        canWriteCompany(request.resource.data) &&
        request.resource.data.creadoPor == request.auth.uid &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'programacion')
      );
      allow update: if (
        hasRole(['planificador']) &&
        sameCompany(resource.data) &&
        sameCompany(request.resource.data) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        canWriteCompany(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion')
      );
      allow delete: if (
        hasRole(['planificador']) && sameCompany(resource.data) && canWriteCompany(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion')
      );
    }

    match /programacionConfirmaciones/{confirmacionId} {
      allow read: if canManageProgramming(resource.data) || (
        activeUser() && sameCompany(resource.data) &&
        resource.data.usuarioId == request.auth.uid &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion')
      );
      allow create: if activeUser() &&
        sameCompany(request.resource.data) &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.empresaId == profile().empresaId &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'programacion');
      allow update: if activeUser() &&
        sameCompany(resource.data) && sameCompany(request.resource.data) &&
        resource.data.usuarioId == request.auth.uid &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.semanaInicio == resource.data.semanaInicio &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion');
      allow delete: if false;
    }

    // Copia mínima e inmutable de la semana publicada para cada trabajador.
    // Se genera exclusivamente desde la Cloud Function de publicación.
    match /programacionPublicadaUsuarios/{publicacionId} {
      allow read: if activeUser() && sameCompany(resource.data) &&
        resource.data.estado == 'publicada' &&
        resource.data.usuarioId == request.auth.uid &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'programacion');
      allow create, update, delete: if false;
    }

    // Acreditaciones SHEQ. Los documentos conservan metadatos, vigencias,
    // revisión e historial operacional; los archivos viven en Storage.
    match /sheqContratos/{contratoId} {
      allow read: if canReadSheq(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'sheq');
      allow create: if canManageSheq(request.resource.data) &&
        request.resource.data.creadoPor == request.auth.uid &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'sheq');
      allow update: if canManageSheq(resource.data) && canManageSheq(request.resource.data) &&
        request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if canManageSheq(resource.data);
    }

    match /sheqVehiculos/{vehiculoId} {
      allow read: if canReadSheq(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'sheq');
      allow create: if canManageSheq(request.resource.data) &&
        request.resource.data.creadoPor == request.auth.uid &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'sheq');
      allow update: if canManageSheq(resource.data) && canManageSheq(request.resource.data) &&
        request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if canManageSheq(resource.data) && recentAuthentication();
    }

    match /sheqDocumentos/{documentoId} {
      allow read: if canReadSheq(resource.data) &&
        moduloEtapaActivo(empresaDeOT(resource.data), 'sheq');
      allow create: if canManageSheq(request.resource.data) &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.entidadTipo in ['persona', 'vehiculo'] &&
        request.resource.data.estado in ['pendiente', 'aprobado', 'observado', 'rechazado'] &&
        moduloEtapaActivo(empresaDeOT(request.resource.data), 'sheq');
      allow update: if canManageSheq(resource.data) && canManageSheq(request.resource.data) &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.creadoPor == resource.data.creadoPor &&
        request.resource.data.entidadTipo in ['persona', 'vehiculo'] &&
        request.resource.data.estado in ['pendiente', 'aprobado', 'observado', 'rechazado'];
      allow delete: if canManageSheq(resource.data) && recentAuthentication();
    }

    match /planes/{planId} {
      allow read: if activeUser();
      allow write: if isSuperAdmin();
    }

    // Parámetros generales de Vectaria.
    // Solo el Super Administrador puede consultarlos o modificarlos.
    match /configuracionGlobal/{configId} {
      allow read, write: if isSuperAdmin();
    }

    match /logsSistema/{logId} {
      allow read: if isSuperAdmin() ||
        (isCompanyWideAdmin() && sameCompany(resource.data));

      // Los registros de auditoría solo se crean mediante Cloud Functions.
      // El SDK Admin omite estas reglas y completa identidad y fecha desde
      // el servidor; ningún navegador puede inventar o alterar eventos.
      allow create, update, delete: if false;
    }

    // Todo lo no declarado queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
