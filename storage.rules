rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(
        /databases/(default)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function activeUser() {
      return signedIn() && profile().activo == true;
    }

    function companyOperational(empresaId) {
      let empresa = firestore.get(
        /databases/(default)/documents/empresas/$(empresaId)
      ).data;
      return (!('activa' in empresa) || empresa.activa != false) &&
        (!('suscripcion' in empresa) || (empresa.suscripcion is map &&
          (!('estado' in empresa.suscripcion) || !(empresa.suscripcion.estado in
            ['cancelacion_solicitada', 'periodo_exportacion', 'pendiente_eliminacion', 'cancelada']))));
    }

    function companyModuleActive(empresaId, moduleName) {
      let empresa = firestore.get(
        /databases/(default)/documents/empresas/$(empresaId)
      ).data;
      return !('modulos' in empresa) ||
        !(empresa.modulos is map) ||
        !(moduleName in empresa.modulos) ||
        empresa.modulos[moduleName] != false;
    }

    function isSuperAdmin() {
      return activeUser() && profile().rol == 'super_admin';
    }

    function ot(otId) {
      return firestore.get(
        /databases/(default)/documents/ots/$(otId)
      ).data;
    }

    function otOpen(otId) {
      let orden = ot(otId);
      return (!('cerrada' in orden) || orden.cerrada != true) &&
        (!('estado' in orden) || orden.estado != 'CERRADA');
    }

    function canAccessOT(otId) {
      return activeUser() && (
        profile().empresaId == ot(otId).empresaId && (
          profile().rol == 'admin_empresa' ||
          (
            profile().sucursalId is string &&
            profile().sucursalId != '' &&
            profile().sucursalId == ot(otId).sucursalId
          )
        )
      );
    }

    function canManageOT(otId) {
      return canAccessOT(otId) && (
        profile().rol in ['jefe_taller', 'supervisor', 'tecnico']
      );
    }

    function canManageCompanyBranding(empresaId) {
      return activeUser() && (
        isSuperAdmin() ||
        (
          profile().rol == 'admin_empresa' &&
          profile().empresaId == empresaId
        )
      );
    }

    function canReadCompanyBranding(empresaId) {
      return activeUser() && (
        isSuperAdmin() || profile().empresaId == empresaId
      );
    }

    function canReadSheq(empresaId) {
      return activeUser() && (
        profile().empresaId == empresaId &&
          profile().rol in ['admin_empresa', 'admin_sucursal', 'jefe_taller', 'planificador', 'sheq'] &&
          companyModuleActive(empresaId, 'sheq')
      );
    }

    function canManageSheq(empresaId) {
      return activeUser() && (
        profile().empresaId == empresaId && profile().rol == 'sheq' &&
          companyModuleActive(empresaId, 'sheq')
      );
    }

    function canReadInventory(empresaId, sucursalId) {
      return activeUser() && (
        profile().empresaId == empresaId && companyModuleActive(empresaId, 'inventario') && (
          profile().rol == 'admin_empresa' ||
          (profile().sucursalId == sucursalId && profile().rol in ['admin_sucursal', 'jefe_taller', 'planificador', 'bodeguero'])
        )
      );
    }

    function canManageInventory(empresaId, sucursalId) {
      return activeUser() && (
        profile().empresaId == empresaId && companyModuleActive(empresaId, 'inventario') && (
          (profile().sucursalId == sucursalId && profile().rol in ['jefe_taller', 'planificador'])
        )
      );
    }

    function validBrandImage() {
      return request.resource != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function validMobileImage() {
      return request.resource.contentType != null &&
        request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif|avif)');
    }

    function validOperationalDocument() {
      return request.resource != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        (validMobileImage() || request.resource.contentType == 'application/pdf');
    }

    function validSheqDocument() {
      return request.resource != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        (validMobileImage() ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    function validChecklistTemplate() {
      return request.resource != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType != null && (
          request.resource.contentType == 'application/vnd.ms-excel' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        );
    }

    match /ots/{otId}/{allPaths=**} {
      allow read: if canAccessOT(otId);

      // El servidor valida usuario, OT y empresa antes de modificar archivos.
      // Storage permite como máximo dos consultas a Firestore por solicitud.
      allow create, update, delete: if false;
    }

    match /empresas/{empresaId}/informe/{fileName} {
      allow read: if canReadCompanyBranding(empresaId);
      allow create, update: if false;
      allow delete: if false;
    }

    match /empresas/{empresaId}/plantillas/{allPaths=**} {
      allow read: if activeUser() && profile().empresaId == empresaId;
      allow create, update: if false;
      allow delete: if false;
    }

    match /empresas/{empresaId}/sheq/{allPaths=**} {
      allow read: if canReadSheq(empresaId);
      allow create, update: if false;
      allow delete: if false;
    }

    match /empresas/{empresaId}/inventario/{sucursalId}/{allPaths=**} {
      allow read: if canReadInventory(empresaId, sucursalId);
      allow create, update: if false;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
