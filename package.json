{
  "name": "overtrack-proyecto",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Vectaria para la gestión operativa, órdenes de trabajo y mantenimiento.",
  "engines": {
    "node": "22.x"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:production": "node scripts/build-production.mjs",
    "check:functions": "npm --prefix functions run check",
    "test:unit": "node --test tests/storage-quota.test.mjs tests/sheq-acreditacion.test.mjs tests/programacion-roles.test.mjs tests/flujo-roles.test.mjs tests/file-validation.test.mjs tests/flujo-sin-cargas-locales.test.mjs",
    "test:rules": "node scripts/run-emulator-tests.mjs rules",
    "test:hosting": "node scripts/run-emulator-tests.mjs hosting",
    "test": "npm run check:functions && npm run test:unit && npm run test:rules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esteban0802/Mantencion-Taller-2.git"
  },
  "keywords": [
    "mantenimiento",
    "ordenes-de-trabajo",
    "firebase"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Esteban0802/Mantencion-Taller-2/issues"
  },
  "homepage": "https://github.com/Esteban0802/Mantencion-Taller-2#readme",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.30.2"
  },
  "dependencies": {
    "chart.js": "4.5.0",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
